<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HandShaker.Detector.SFUserAgreementMsg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:HandShaker.Detector" Title="SFUserAgreementMsg" BorderThickness="20" Width="566" WindowStyle="None" WindowState="Normal" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency="True" SnapsToDevicePixels="True" ShowInTaskbar="False" Background="{x:Null}">
  <UIElement.Effect>
    <DropShadowEffect ShadowDepth="0" BlurRadius="13" Direction="270" Opacity="0.36" Color="#FF211613" />
  </UIElement.Effect>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/MainSkin.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Height="635">
    <Border Background="#fafafa" BorderThickness="1" BorderBrush="#20000000" SnapsToDevicePixels="True">
      <Grid>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DefaultScrollBar}" />
            <Style x:Key="{x:Type ScrollViewer}" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource leftMenuConstainerScrollViewer}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="37" />
          <RowDefinition Height="*" />
          <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,1" BorderBrush="#b7b7b7" MouseLeftButtonDown="Window_MouseLeftButtonDown">
          <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
              <GradientStop Color="#FFEBEBEB" Offset="0" />
              <GradientStop Color="#FFDADADB" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Button Name="minBtn" Style="{DynamicResource MinImageButtonStyle}" Grid.Column="1" Click="MinBtn_Click" />
            <Button Name="closeBtn" Style="{DynamicResource CloseImageButtonStyle}" Grid.Column="2" Click="CloseBtn_Click" />
          </Grid>
        </Border>
        <DockPanel Grid.Row="1">
          <Border Margin="30,30,30,0" BorderBrush="#20000000" BorderThickness="1" CornerRadius="4" Background="#ffffff">
            <RichTextBox Name="richTextBox" Margin="7,7,2,0" BorderThickness="0" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Border>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{StaticResource NSHumanReadableCopyright}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#66000000" />
      </Grid>
    </Border>
  </Grid>
</Window>
