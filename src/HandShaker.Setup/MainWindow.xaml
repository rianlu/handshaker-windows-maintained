<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HandShakerSimpleSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:HandShakerSimpleSetup" xmlns:converter="clr-namespace:HandShakerSimpleSetup.Converter" Width="636" BorderThickness="10" SizeToContent="Height" WindowStyle="None" WindowState="Normal" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency="True" SnapsToDevicePixels="True" Title="HandShaker" Background="{x:Null}" MouseLeftButtonDown="OnHitTest">
  <UIElement.Effect>
    <DropShadowEffect ShadowDepth="0" BlurRadius="13" Direction="270" Opacity="0.36" Color="#FF211613" />
  </UIElement.Effect>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/MainSkin.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converter:InstallPathVisibilityConverter x:Key="installPathVisibilityConverter" />
      <LinearGradientBrush x:Key="TextBoxBorder" EndPoint="0,20" MappingMode="Absolute" StartPoint="0,0">
        <GradientStop Color="#ABADB3" Offset="0.05" />
        <GradientStop Color="#E2E3EA" Offset="0.07" />
        <GradientStop Color="#E3E9EF" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="PathTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{x:Null}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="UIElement.AllowDrop" Value="True" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Grid>
                <Border SnapsToDevicePixels="True" CornerRadius="4" BorderThickness="1" BorderBrush="#26000000" Height="28">
                  <ScrollViewer Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border Background="#FFFFFFFF" BorderThickness="1" BorderBrush="#20000000" ClipToBounds="True" SnapsToDevicePixels="True">
      <StackPanel Orientation="Vertical">
        <Border Height="37" BorderThickness="0,0,0,1" BorderBrush="#b7b7b7">
          <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
              <GradientStop Color="#FFEBEBEB" Offset="0" />
              <GradientStop Color="#FFDADADB" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
              </Grid.ColumnDefinitions>
              <Button Name="minBtn" Style="{DynamicResource MinImageButtonStyle}" Grid.Column="1" Click="MinBtn_Click" />
              <Button Name="closeBtn" Style="{DynamicResource CloseImageButtonStyle}" Grid.Column="2" Click="CloseBtn_Click" />
            </Grid>
            <Label Content="{StaticResource HandShaker}" Foreground="#cc000000" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
          </Grid>
        </Border>
        <Grid Height="339">
          <Image Name="Image1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" Height="64" Source="Resources/titleicon.png" Stretch="UniformToFill" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{StaticResource HandShaker}" Margin="0,112,0,0" Foreground="#cc000000" FontSize="15" />
          <TextBlock Name="Text2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="410" Text="{StaticResource HandShaker So that you can easily on the Win also freely manage your content in Android phone}" Margin="0,-220,0,0" Foreground="#cc000000" FontSize="15" />
          <Image Name="Image2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="337" Height="223" Source="Resources/install.png" Stretch="UniformToFill" Margin="0,100,0,0" />
        </Grid>
        <StackPanel Name="startInstallView" Orientation="Vertical" Visibility="Visible">
          <Panel.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFF6F6F6" Offset="0" />
              <GradientStop Color="#FFF4F4F4" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Border BorderBrush="#f0f0f0" BorderThickness="0,1,0,0" Height="66" Margin="16,0">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <CheckBox Name="installOption" IsChecked="False" Content="{StaticResource Installation Options}" VerticalAlignment="Center" Style="{DynamicResource InstallOptionCheckBoxStyle}" />
                <Button Name="btnStart" Margin="12,0,0,0" VerticalAlignment="Center" Content="{StaticResource Start Installation}" Style="{DynamicResource StartInstallButtonStyle}" Click="StartInstallation_Click" />
              </StackPanel>
              <CheckBox Name="chkAgree" Foreground="#cc000000" Content="{StaticResource I have agreed HandShaker}" Style="{StaticResource CheckBoxStyle}" IsChecked="True" Unchecked="chkAgree_Unchecked" Checked="chkAgree_Checked" />
              <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                <Hyperlink Name="checkSolutionLink" Foreground="#406cd3" FontSize="13" FocusVisualStyle="{x:Null}" Click="CheckLink_Click">
                  <AccessText Text="{StaticResource User License Agreement}" />
                </Hyperlink>
              </TextBlock>
            </DockPanel>
          </Border>
          <Border BorderBrush="#f0f0f0" BorderThickness="0,1,0,0" Height="66" Visibility="{Binding IsChecked, ElementName=installOption, Converter={StaticResource installPathVisibilityConverter}}">
            <DockPanel FlowDirection="RightToLeft">
              <Button Margin="17,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource ChangeInstallLocationButtonStyle}" Click="ChangeInstallLocationButton_Click" />
              <TextBox Name="installPath" Margin="10,0,17,0" Text="D:\Program Files\HandShaker" VerticalAlignment="Center" HorizontalAlignment="Stretch" Foreground="#9A000000" FontSize="12" IsReadOnly="True" Style="{DynamicResource PathTextBoxStyle}" FlowDirection="LeftToRight" Background="#f0f0f0" />
            </DockPanel>
          </Border>
        </StackPanel>
        <StackPanel Name="installationView" Visibility="Collapsed" TextBlock.Foreground="#9a000000" TextBlock.FontSize="13">
          <Panel.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFF6F6F6" Offset="0" />
              <GradientStop Color="#FFF4F4F4" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Border BorderBrush="#f0f0f0" BorderThickness="0,1,0,0" Height="66">
            <DockPanel Margin="20,0">
              <StackPanel Name="completionButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                <Button Name="btnCloseComplete" Margin="12,0,0,0" VerticalAlignment="Center" Content="{StaticResource Close}" Style="{DynamicResource SecondaryButtonStyle}" Click="CloseInstallation_Click" />
                <Button Name="btnOpen" Margin="12,0,0,0" VerticalAlignment="Center" Content="{StaticResource Open}" Style="{DynamicResource StartInstallButtonStyle}" Click="OpenHandShaker_Click" />
              </StackPanel>
              <TextBlock Name="completionMessage" VerticalAlignment="Center" Text="{StaticResource complete}" Visibility="Collapsed" />
              <StackPanel Name="installationProgress" Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{StaticResource Installation in progress}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                  <TextBlock Name="progressValue" Margin="5,0,0,0" />
                  <TextBlock Text="%" />
                </StackPanel>
                <local:HSProgressBar x:Name="progressBar" Value="0" Height="5" Margin="0,10,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
