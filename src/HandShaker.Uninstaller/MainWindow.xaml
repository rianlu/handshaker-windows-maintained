<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HandShakerUninstaller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HandShakerSimpleSetup" Width="636" BorderThickness="10" SizeToContent="Height" WindowStyle="None" WindowState="Normal" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency="True" SnapsToDevicePixels="True" Title="HandShaker" Background="{x:Null}" MouseLeftButtonDown="OnHitTest">
  <Window.Effect>
    <DropShadowEffect ShadowDepth="0" BlurRadius="13" Direction="270" Opacity="0.36" Color="#FF211613" />
  </Window.Effect>
  <Grid>
    <Border Background="#FFFFFFFF" BorderThickness="1" BorderBrush="#20000000" ClipToBounds="True" SnapsToDevicePixels="True">
      <StackPanel Orientation="Vertical">
        <Border Height="37" BorderThickness="0,0,0,1" BorderBrush="#b7b7b7">
          <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFEAEAEA" Offset="0" />
              <GradientStop Color="#FFDCDCDD" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Label Content="{StaticResource HandShaker}" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#cc000000" FontSize="14" />
            <Button Name="minBtn" Style="{DynamicResource MinImageButtonStyle}" Grid.Column="1" Click="MinBtn_Click" />
            <Button Name="closeBtn" Style="{DynamicResource CloseImageButtonStyle}" Grid.Column="2" Click="CloseBtn_Click" />
          </Grid>
        </Border>
        <Grid Height="339">
          <Image HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" Height="64" Source="Resources/titleicon.png" Stretch="UniformToFill" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{StaticResource HandShaker}" Margin="0,112,0,0" Foreground="#cc000000" FontSize="15" />
        </Grid>
        <Border Name="startUninstallView" BorderBrush="#f0f0f0" BorderThickness="0,1,0,0" Height="66">
          <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFF6F6F6" Offset="0" />
              <GradientStop Color="#FFF4F4F4" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <DockPanel>
            <Button Name="btnStart" DockPanel.Dock="Right" Margin="12,0,16,0" VerticalAlignment="Center" Content="{StaticResource Start uninstall}" Style="{DynamicResource StartInstallButtonStyle}" Click="StartUninstall_Click" />
            <CheckBox Name="chkKeepUserFile" Margin="16,0,0,0" Content="{StaticResource Keep the relevant user files}" Foreground="#cc000000" VerticalAlignment="Center" Style="{DynamicResource CheckBoxStyle}" IsChecked="True" />
          </DockPanel>
        </Border>
        <Border Name="uninstallationView" BorderBrush="#f0f0f0" BorderThickness="0,1,0,0" Height="66" Visibility="Collapsed" TextBlock.Foreground="#9a000000" TextBlock.FontSize="13">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="20,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{StaticResource Uninstall in progress}" />
              <TextBlock Name="progressValue" Margin="5,0,0,0" Text="0" />
              <TextBlock Text="%" />
            </StackPanel>
            <controls:HSProgressBar x:Name="progressBar" Value="0" Height="5" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Name="completionView" BorderBrush="#f0f0f0" BorderThickness="0,1,0,0" Height="66" Visibility="Collapsed">
          <DockPanel Margin="20,0">
            <Button Name="btnFinish" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="{StaticResource Close}" Style="{DynamicResource SecondaryButtonStyle}" Click="Finish_Click" />
            <TextBlock Name="completionMessage" VerticalAlignment="Center" Foreground="#9a000000" FontSize="13" Text="{StaticResource Uninstall complete}" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
